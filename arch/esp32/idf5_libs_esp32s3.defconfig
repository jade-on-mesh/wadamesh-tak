# Wadamesh TAK: settings added to esp32-arduino-lib-builder's configs/defconfig.esp32s3
# when CI builds tuned Arduino 3.3.11 libraries (IDF5_MIGRATION.md, phase 3).
# Everything else matches the libraries pioarduino 55.03.311 ships (lib-builder ee57070,
# ESP-IDF v5.5.5, their dependencies.lock). On the S3, IRAM and DRAM share one internal
# SRAM, so code moved out of IRAM is internal heap.
#
# Already off in the stock libraries: CONFIG_ESP_WIFI_IRAM_OPT, CONFIG_ESP_WIFI_RX_IRAM_OPT,
# CONFIG_LWIP_IRAM_OPTIMIZATION.

# Framework code from IRAM to flash.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y

# NimBLE's host pools in PSRAM (the Pager's fix, now for every board).
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Lets EXT_RAM_BSS_ATTR put statics in PSRAM (unused until code opts in).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
